// Bu dosya src/components/Hand.test.tsx için ilgili kodları içerir.
// Hand bileşeni testleri: render ve kullanıcı etkileşimleri
import { describe, expect, it, vi, beforeEach, afterEach } from 'vitest';
import { render, screen, rerender } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import { Hand } from './Hand';
import { useGameStore } from '../state/store';
import { setupMockRandom, resetMockRandom } from '../testUtils';
import { cleanup } from '@testing-library/react';
import type { Card } from '../types/game';

describe('Hand', () => {
  const baseCard: Card = {
    id: 'card-1',
    isim: 'Test Kartı',
    tip: 'saldırı',
    manaBedeli: 1,
    baseHasar: 1,
    zarTuru: 'd4',
    effects: [{ kind: 'attack', die: 'd4' }],
    isUpgraded: false,
    rarity: 'common',
    tags: ['attack'],
  };

  const anotherCard: Card = {
    id: 'card-2',
    isim: 'İkinci Kart',
    tip: 'savunma',
    manaBedeli: 2,
    baseHasar: 0,
    zarTuru: 'd4',
    effects: [{ kind: 'block', amount: 2 }],
    isUpgraded: false,
    rarity: 'uncommon',
    tags: ['defense'],
  };

  beforeEach(() => {
    // Reset store to a default state
    useGameStore.setState({
      initialized: true,
      gamePhase: 'combat',
      isPlayerTurn: true,
      player: { id: 'player', isim: 'Ero', mevcutCan: 10, maksimumCan: 10, zirhSinifi: 12, gucCarpani: 2, advantageCounter: 0, disadvantageCounter: 0 },
      enemy: { id: 'enemy', isim: 'Goblin', mevcutCan: 10, maksimumCan: 10, zirhSinifi: 11, gucCarpani: 1, advantageCounter: 0, disadvantageCounter: 0 },
      maxEnergy: 3,
      currentEnergy: 3,
      deck: [],
      hand: [baseCard, anotherCard],
      discardPile: [],
      drawCount: 5,
      gold: 50,
      battleLogs: [],
      rewardOptions: [],
      playerBlock: 0,
      enemyBlock: 0,
      enemySkipNextTurn: false,
      victoryCount: 0,
      enemyIntent: { type: 'attack', estimatedDamage: 0 },
      enemyIntentValue: 0,
      enemyArchetype: 'goblin',
      playerStatuses: [],
      enemyStatuses: [],
      comboChain: [],
      comboCount: 0,
      nextDamageBonus: 0,
    });
    setupMockRandom([0]);
    vi.restoreAllMocks();
  });

  afterEach(() => {
    cleanup();
    resetMockRandom();
    vi.restoreAllMocks();
  });

  it('renders the cards in hand', () => {
    render(<Hand />);
    expect(screen.getByText(/Test Kartı/i)).toBeInTheDocument();
    expect(screen.getByText(/İkinci Kart/i)).toBeInTheDocument();
    expect(screen.getAllByRole('button')).toHaveLength(2); // two cards
  });

  it('shows empty state when hand is empty', () => {
    useGameStore.setState({ ...useGameStore.getState(), hand: [] });
    render(<Hand />);
    expect(screen.getByText(/Elinizde kart yok/i)).toBeInTheDocument();
    expect(screen.queryAllByRole('button')).toHaveLength(0);
  });

  it('only allows playing cards when in combat phase and player turn and has enough energy', async () => {
    const playCardSpy = vi.spyOn(useGameStore.getState(), 'playCard');
    render(<Hand />);

    // first card costs 1 mana, we have 3 energy -> playable
    const firstCardButton = screen.getByRole('button', { name: /Test Kartı oynanabilir/i });
    expect(firstCardButton).not.toBeDisabled();

    // second card costs 2 mana, we have 3 energy -> playable
    const secondCardButton = screen.getByRole('button', { name: /İkinci Kart oynanabilir/i });
    expect(secondCardButton).not.toBeDisabled();

    // click first card
    await userEvent.click(firstCardButton);
    expect(playCardSpy).toHaveBeenCalledTimes(1);
    expect(playCardSpy).toHaveBeenCalledWith('card-1');

    // reset spy
    playCardSpy.mockClear();

    // now set energy to 0, should not be able to play any card
    useGameStore.setState({ ...useGameStore.getState(), currentEnergy: 0 });
    // re-render? The store is reactive, so the component will update.
    // Debug: list buttons
    const buttons = screen.getAllByRole('button');
    console.log('Buttons after setting energy to 0:', buttons.map(b => b.getAttribute('aria-label')));
    // Wait for the button to reflect disabled state
    await screen.findByRole('button', { name: /Test Kartı için yeterli enerji yok/i });
    const firstCardButtonAfter = screen.getByRole('button', { name: /Test Kartı için yeterli enerji yok/i });
    expect(firstCardButtonAfter).toBeDisabled();
    const secondCardButtonAfter = screen.getByRole('button', { name: /İkinci Kart için yeterli enerji yok/i });
    expect(secondCardButtonAfter).toBeDisabled();

    // click should not call playCard
    await userEvent.click(firstCardButtonAfter);
    expect(playCardSpy).not.toHaveBeenCalled();
  });
    const playCardSpy = vi.spyOn(useGameStore.getState(), 'playCard');
    useGameStore.setState({ ...useGameStore.getState(), gamePhase: 'mapSelection' });
    render(<Hand />);

    const firstCardButton = screen.getByRole('button', { name: /Test Kartı için yeterli enerji yok/i }); // because not in combat, isPlayable will be false
    expect(firstCardButton).toBeDisabled();
    await userEvent.click(firstCardButton);
    expect(playCardSpy).not.toHaveBeenCalled();
  });

  it('does not allow playing when not player turn', async () => {
    const playCardSpy = vi.spyOn(useGameStore.getState(), 'playCard');
    useGameStore.setState({ ...useGameStore.getState(), isPlayerTurn: false });
    render(<Hand />);

    const firstCardButton = screen.getByRole('button', { name: /Test Kartı için yeterli enerji yok/i }); // because not player turn
    expect(firstCardButton).toBeDisabled();
    await userEvent.click(firstCardButton);
    expect(playCardSpy).not.toHaveBeenCalled();
  });

  it('applies correct styling based on game phase and turn', () => {
    // combat and player turn -> active
    useGameStore.setState({ ...useGameStore.getState(), gamePhase: 'combat', isPlayerTurn: true });
    const { rerender } = render(<Hand />);
    let handDiv = screen.getByRole('list');
    expect(handDiv).not.toHaveClass('hand-grid--inactive');

    // not combat -> inactive
    useGameStore.setState({ ...useGameStore.getState(), gamePhase: 'mapSelection' });
    rerender(<Hand />);
    handDiv = screen.getByRole('list');
    expect(handDiv).toHaveClass('hand-grid--inactive');

    // combat but not player turn -> inactive
    useGameStore.setState({ ...useGameStore.getState(), gamePhase: 'combat', isPlayerTurn: false });
    rerender(<Hand />);
    handDiv = screen.getByRole('list');
    expect(handDiv).toHaveClass('hand-grid--inactive');
  });
});
